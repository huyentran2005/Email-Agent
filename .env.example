POSTGRES_DB=email_agent
POSTGRES_USER=email_agent
POSTGRES_PASSWORD=email_agent_dev_password
DATABASE_URL=postgresql+psycopg://email_agent:email_agent_dev_password@localhost:5432/email_agent

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_password
MINIO_BUCKET=email-attachments
MINIO_SECURE=false

# Bật để quét nội dung attachment bằng ClamAV trước khi lưu metadata.
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Proxy LLM tương thích OpenAI Chat Completions. Không dùng embedding/vector search.
LLM_PROXY_BASE_URL=https://your-proxy.example.com/v1
LLM_PROXY_API_KEY=replace-with-proxy-key
LLM_MODEL=replace-with-model-name
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=3
LLM_JSON_MODE=true
LLM_ALLOW_SUSPICIOUS_EMAIL=false
LLM_VERIFY_SUMMARY=true

# Celery dùng Redis DB 0 làm broker và DB 1 lưu trạng thái/kết quả task.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_QUEUE_NAME=email-llm
CELERY_KEY_PREFIX=email-agent:
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_RESULT_EXPIRES=86400
CELERY_TASK_MAX_RETRIES=4
CELERY_TASK_RETRY_BACKOFF=30
CELERY_WORKER_CONCURRENCY=1
# Trên Windows dùng solo; Linux production nên dùng prefork.
CELERY_WORKER_POOL=solo

GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
INITIAL_SYNC_DAYS=30
SYNC_PAGE_SIZE=100
GMAIL_QUOTA_UNITS_PER_MINUTE=4800
GMAIL_RETRY_MAX_ATTEMPTS=8
GMAIL_RETRY_BASE_DELAY_SECONDS=1
GMAIL_RETRY_MAX_DELAY_SECONDS=60
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GMAIL_PUBSUB_TOPIC=gmail-notifications
GMAIL_PUBSUB_SUBSCRIPTION=gmail-notifications-sub
GMAIL_WATCH_RENEWAL_SECONDS=86400
